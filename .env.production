# Production build env (loaded automatically by `vite build`).
# All VITE_* values are PUBLIC — they are inlined into the client bundle.
# Change the domain here (or override with a gitignored .env.production.local
# / CI env vars) if your API is served elsewhere.
#
# Requires, on the backend side:
#   - API reachable at VITE_API_BASE_URL over HTTPS
#   - CORS allowlist includes the app origin, with credentials: true
#   - session cookie Domain=.fleet-taxi.id, SameSite=None, Secure (cross-subdomain)

VITE_API_BASE_URL=https://api.fleet-taxi.id
VITE_WS_URL=wss://api.fleet-taxi.id/rt
VITE_APP_ENV=production
VITE_USE_MSW=false
