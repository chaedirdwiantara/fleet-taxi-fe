# Frontend env vars — PROJECT-BRIEF.md §7 + dev toggles (frontend-kickoff.md §9).
# All values are zod-validated at startup in src/lib/env.

# Production shape:
#   VITE_API_BASE_URL=https://api.fleet-taxi.id
#   VITE_WS_URL=wss://api.fleet-taxi.id/rt
# Dev shape (Vite proxy handles cookies/CORS — see vite.config.ts):
VITE_API_BASE_URL=/api
VITE_WS_URL=/rt
VITE_APP_ENV=local
# "true" = serve the app from MSW mocks (no backend needed)
VITE_USE_MSW=true
